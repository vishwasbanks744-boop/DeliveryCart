DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set True after configuring Firebase Email/Password sign-in and all values below.
FIREBASE_AUTH_ENABLED=False
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_JS_SDK_VERSION=13.1.0
# Choose one server credential source. Keep both out of source control.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional, browser-visible Google Maps key. Restrict it by HTTP referrer in Google Cloud.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
DELIVERY_DISPATCH_RADIUS_KM=10

# Cashfree PG. Keep the secret key private. Start in sandbox; enable after keys
# and a public HTTPS webhook URL are configured in the Cashfree dashboard.
CASHFREE_ENABLED=False
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01
